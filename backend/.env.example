
PORT=3001
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/safetymap

# ========================================================
# みんなの安全マップ - バックエンド環境変数設定ファイル
# ========================================================
# 本ファイルをコピーして `.env` を作成し、Google AI Studio で取得した APIキー を設定してください。
# ※ `.env` ファイルは Git 管理対象外 (.gitignore) に設定されています。
#
# Google AI Studio APIキー取得先:
# https://aistudio.google.com/app/apikey
# ========================================================

# Gemini API Key (必須: AIアシスト・アドバイス・サマリー機能に使用)
# 未設定または 'your_gemini_api_key_here' の場合はスマートフォールバック（自動ルール判定）モードで安全に動作します。
GEMINI_API_KEY=your_gemini_api_key_here

# サーバーポート番号 (デフォルト: 3001)
PORT=3001

