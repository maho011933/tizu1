# ========================================================
# みんなの安全マップ (Hazard Map) - バックエンド環境変数設定ファイル
# ========================================================
# 本ファイルをコピーして `.env` を作成し、必要に応じて設定をカスタマイズしてください。
# ※ `.env` ファイルは Git 管理対象外 (.gitignore) に設定されています。
#
# コピー実行コマンド:
# cp backend/.env.example backend/.env
# ========================================================

# --------------------------------------------------------
# 1. 基本サーバー設定 (Server Configuration)
# --------------------------------------------------------
# サーバーの待受ポート番号 (デフォルト: 3001)
PORT=3001

# 動作環境 (development / test / production)
NODE_ENV=development

# API / 画像配信の基準URL (未設定時はリクエストホストから自動判定)
BASE_URL=http://localhost:3001

# --------------------------------------------------------
# 2. AI / Google Gemini API 設定 (AI Advice & Assist)
# --------------------------------------------------------
# Google AI Studio で取得した Gemini APIキー (必須: AIアシスト・アドバイス・危険度自動判定機能に使用)
# ※ 未設定または 'your_gemini_api_key_here' の場合はスマートフォールバック（自動ルール判定）モードで安全に動作します。
# 取得先: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------
# 3. データベース設定 (PostgreSQL + PostGIS)
# --------------------------------------------------------
# PostGISデータベース接続URL (Docker Compose環境デフォルト)
# ※ 未接続または接続失敗時は、ローカルJSONファイル (backend/data/hazards.json) に自動フォールバックします。
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/safetymap

# 個別接続パラメータ (DATABASE_URL が指定されていない場合に使用)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safetymap
DB_USER=postgres
DB_PASSWORD=postgrespassword

# --------------------------------------------------------
# 4. 画像ストレージ設定 (Storage Provider Configuration)
# --------------------------------------------------------
# ストレージプロバイダーの選択: 'local' | 's3' | 'cloudinary' (デフォルト: local)
STORAGE_PROVIDER=local

# AWS S3 設定 (STORAGE_PROVIDER=s3 の場合に使用)
AWS_S3_BUCKET_NAME=your_aws_s3_bucket_name
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS CloudFront ドメイン (任意: 設定時はCDN URLが返却されます)
# AWS_CLOUDFRONT_DOMAIN=your_cloudfront_subdomain.cloudfront.net

# Cloudinary 設定 (STORAGE_PROVIDER=cloudinary の場合に使用)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------
# 5. データファイルパス設定 (Data File Paths / テスト用)
# --------------------------------------------------------
# 危険箇所データ保存ファイルパス (未設定時は backend/data/hazards.json を自動参照)
# HAZARDS_DATA_FILE=backend/data/hazards.json

# フィードバック保存ファイルパス (未設定時は backend/data/feedback.json を自動参照)
# FEEDBACK_DATA_FILE=backend/data/feedback.json
